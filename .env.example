# Hookdrop configuration
#
# Copy to `.env` at the repository root and fill in. Every service resolves this file by
# walking up from its own directory, so one file at the root serves all four apps — that is
# why the four services previously called `dotenv.config({ path: '../../.env' })` and only
# worked when started from their own directory (H-44).
#
# The three Node services validate this file with Zod at import and refuse to start on a
# missing or malformed required value, naming the variable and the reason. There are no
# silent localhost fallbacks any more: a missing REDIS_URL used to mean events were accepted
# and never delivered (H-09).
#
# NOTHING IN THIS FILE IS A REAL CREDENTIAL. Replace every placeholder.

# =============================================================================
# Shared — read by api, ingestion and worker
# =============================================================================

NODE_ENV=development

# Required, all three services. No default.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hookdrop

# Required, all three services. Use `rediss://` for a managed instance; TLS is enabled
# automatically for that scheme. No default — this is deliberate (H-09).
REDIS_URL=redis://localhost:6379

# Postgres pool ceiling per process. Three services share one instance, so the driver
# default of 10 each can exhaust a small managed database.
# api=10, ingestion=10, worker=5 by default.
DATABASE_POOL_MAX=10

# Required in production: builds the CORS and Socket.IO origin allow-lists, and is
# interpolated into every dashboard link in outbound email.
FRONTEND_URL=http://localhost:3004

# Optional extra allowed origins, comma-separated. For Vercel preview deployments.
# EXTRA_ORIGINS=https://hookdrop-git-branch.vercel.app

SENTRY_DSN=
# Fraction of requests traced, 0 to 1. Defaults to 0.1 in production, 1 in development.
# Was hardcoded to 1.0 in ingestion and worker (H-43).
SENTRY_TRACES_SAMPLE_RATE=1

# Number of proxies in front of the service. 1 for Railway/Vercel/Fly behind one load
# balancer. Not a boolean: `true` lets any client forge `X-Forwarded-For` and bypass every
# rate limiter, while leaving it unset buckets the whole internet into one key (H-19).
TRUST_PROXY_HOPS=1

# --- Email (Resend) ---
RESEND_API_KEY=

# Required in production, and `onboarding@resend.dev` is rejected there: it is Resend's
# shared sandbox sender and only delivers to the account owner's own address, so every
# customer email was silently dropped (H-31). Use a domain verified in Resend.
EMAIL_FROM=Hookdrop <noreply@yourdomain.com>

# =============================================================================
# API service
# =============================================================================

# Defaults to 3003. `API_PORT` is accepted as an alias.
PORT=3003

# --- Token signing ---
# Both required. Minimum 32 characters in production, must differ from each other, and
# known placeholder strings are rejected — a shared secret means a refresh token is
# accepted as an access token (H-01).
# Generate with: openssl rand -base64 48
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# Renamed. The old example called these JWT_EXPIRES_IN / REFRESH_TOKEN_EXPIRES_IN, which
# no code has ever read.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- API keys ---
# Pepper for the `api_keys` hashes (H-27). Optional: when unset, the pepper is derived from
# REFRESH_TOKEN_SECRET through a domain-separated HMAC, so API keys work out of the box.
# Setting it decouples the two, which matters during an incident — otherwise rotating
# REFRESH_TOKEN_SECRET revokes every customer's API key along with every session. Rotating
# this value revokes every API key and nothing else.
# Generate with: openssl rand -base64 48
# API_KEY_SECRET=

# Where the API tells the frontend to send webhooks.
INGESTION_URL=http://localhost:3002

# --- AI (Google Gemini) ---
# Renamed. The old example called this ANTHROPIC_API_KEY; the code uses Gemini.
GEMINI_API_KEY=

# --- Admin access ---
# Comma-separated list of admin addresses. ADMIN_EMAIL (singular) is still read as a
# fallback because it was the original name; three modules previously read three different
# variables, which is why every admin route returned 403 (H-31).
ADMIN_EMAILS=
# ADMIN_EMAIL=

# --- Payments ---
# Which provider a checkout uses when the client does not name one. In production its
# secret key must be configured or the service refuses to start.
DEFAULT_PAYMENT_PROVIDER=paystack

PAYSTACK_SECRET_KEY=

FLUTTERWAVE_SECRET_KEY=
# Required in production whenever FLUTTERWAVE_SECRET_KEY is set. Flutterwave does not sign
# payloads: it sends this exact shared secret in the `verif-hash` header, and it is compared
# in constant time. Without it every Flutterwave webhook is rejected, so payments would be
# taken and never granted (H-05).
FLUTTERWAVE_SECRET_HASH=

STRIPE_SECRET_KEY=
# Required in production whenever STRIPE_SECRET_KEY is set, for the same reason.
STRIPE_WEBHOOK_SECRET=

# Naira per US dollar, used to price Stripe checkout sessions. Replaces a rate that was
# hardcoded in the Stripe provider and duplicated twice more in the routes file (H-36).
NGN_PER_USD=1600

# --- Public demo endpoint ---
DEMO_PUBLIC_TOKEN=change-me-demo-token
DEMO_RETENTION_HOURS=1

# =============================================================================
# Ingestion service
# =============================================================================

# Defaults to 3002. `INGESTION_PORT` is accepted as an alias.
INGESTION_PORT=3002

# Largest inbound webhook accepted, in bytes. The body parser was mounted with no limit at
# all, so it silently used body-parser's 100kb default (H-32). Oversized bodies now get a
# 413 that says so.
MAX_INGEST_BODY_BYTES=262144

# =============================================================================
# Worker service
# =============================================================================

# Delivery jobs processed concurrently. Each one makes an outbound HTTP request.
DELIVERY_CONCURRENCY=5
EMAIL_CONCURRENCY=2

# Timezone for the daily 9am subscription check, so "9am" is one specific instant rather
# than whatever the host clock is set to.
SCHEDULER_TIMEZONE=UTC

# The demo endpoint whose events the hourly cleanup prunes. Was a bare UUID literal inside
# a raw SQL string.
DEMO_ENDPOINT_ID=00000000-0000-0000-0000-000000000002

# --- Event retention (H-18) ---
# The per-plan retention window advertised on the pricing page and promised in the welcome
# email was enforced by nothing: `retention_hours` existed in the plan catalogue and no code
# read it, so every event ever received is still stored. The retention scheduler enforces it.
#
# Read this before enabling it in an existing deployment: the first run deletes everything
# already past its plan's window, which for accounts on the free plan is every event older
# than 24 hours. That is the advertised behaviour, and it is irreversible.
#
# The only scheduled job that destroys customer data, so it has an off switch that does not
# require a code change. Accepts 1/0, true/false, yes/no, on/off; anything else is rejected
# at boot rather than quietly read as "on".
RETENTION_ENABLED=true

# Rows deleted per statement, and statements per plan per run. Together they cap one run's
# blast radius at BATCH_SIZE × MAX_BATCHES_PER_RUN events per plan (100,000 by default), and
# a run that hits the cap says so in its log rather than truncating silently. Lowering these
# makes the first run after enabling take several hours instead of minutes, which is a
# reasonable thing to want.
RETENTION_BATCH_SIZE=5000
RETENTION_MAX_BATCHES_PER_RUN=20

# =============================================================================
# Frontend (apps/web)
# =============================================================================
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time. Never put a
# secret in one.

NEXT_PUBLIC_API_URL=http://localhost:3003
NEXT_PUBLIC_INGESTION_URL=http://localhost:3002

# Server-side only, used by the demo proxy route. Falls back to NEXT_PUBLIC_INGESTION_URL.
# INGESTION_URL=http://localhost:3002

# =============================================================================
# Present in the previous .env.example, read by nothing
# =============================================================================
# Listed so the drift is visible rather than silently carried forward. Confirm each is
# genuinely unused in your deployment before deleting it from your own .env:
#
#   PAYMENT_MODE                 — test mode was removed in commit 5bdc761.
#   JWT_EXPIRES_IN               — superseded by ACCESS_TOKEN_TTL.
#   REFRESH_TOKEN_EXPIRES_IN     — superseded by REFRESH_TOKEN_TTL.
#   ANTHROPIC_API_KEY            — superseded by GEMINI_API_KEY.
#   FLUTTERWAVE_PUBLIC_KEY       — no service config reads it. The frontend loads
#   FLUTTERWAVE_ENCRYPTION_KEY     Flutterwave's v3.js; if an inline checkout needs the
#   STRIPE_PUBLISHABLE_KEY         public key it must be exposed as NEXT_PUBLIC_*, and the
#                                  encryption key must never be.
